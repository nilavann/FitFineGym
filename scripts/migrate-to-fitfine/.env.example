# Copy to .env.local (git-ignored) and fill in. A variable already set in the shell wins over this file.
# Both URLs must be Supabase direct connections (Project Settings -> Database -> Direct connection):
#   postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres
# The session and transaction poolers are refused. The direct connection is IPv6-only: the machine
# running the script needs IPv6, or the project needs the IPv4 add-on.

# Current project, only ever read.
SOURCE_DB_URL=postgresql://postgres:PASSWORD@db.OLD_REF.supabase.co:5432/postgres
# New project (for --final: a brand-new one). The run drops and recreates TARGET_SCHEMA and empties
# auth.users / auth.identities here, then deploys the backend to it.
TARGET_DB_URL=postgresql://postgres:PASSWORD@db.NEW_REF.supabase.co:5432/postgres
TARGET_SCHEMA=fitfine

# Only for --photos and --validate-photos (Storage API). Each URL's <ref> must match its DB URL's.
# The source key is used for GET requests only.
SOURCE_SUPABASE_URL=https://OLD_REF.supabase.co
SOURCE_SERVICE_ROLE_KEY=
TARGET_SUPABASE_URL=https://NEW_REF.supabase.co
TARGET_SERVICE_ROLE_KEY=
PHOTO_BUCKET=member-photos

# Only for --deploy-functions and --final (the Edge Functions go up through the Management API).
# A personal access token: Dashboard -> Account (top right) -> Access Tokens. It starts with sbp_;
# a key starting with eyJ (anon or service role) is refused. It reaches every project in your
# account: revoke it after the run. The target project's ref is taken from TARGET_SUPABASE_URL.
# Not needed: a separate ref, the database password (the migrations use TARGET_DB_URL), and any
# function secret (the platform gives every function its URL and keys).
SUPABASE_ACCESS_TOKEN=

