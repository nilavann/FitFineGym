# Copy this file to .env.local (already gitignored) and fill in your Supabase project's values.
# Find these under Supabase dashboard -> Project Settings -> API.
# The anon key is safe for the frontend bundle; NEVER put the service role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
